# Local M1 configuration template. No loader/server is implemented yet.
APP_ENV=development
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio

# Resolve this path to an absolute directory at startup.
DATA_ROOT=./runtime
# These subdirectories are relative to DATA_ROOT.
IMPORT_SUBDIR=imports
PDF_SUBDIR=pdfs
SQLITE_FILENAME=solo_leveling.sqlite3
CHROMA_SUBDIR=chroma
MODEL_CACHE_SUBDIR=models
LOG_SUBDIR=logs

# Library selected; exact multilingual model/revision still to be selected.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=
EMBEDDING_REVISION=

# Choose one external generation provider and model before implementation.
GENERATION_PROVIDER=
GENERATION_MODEL=
GENERATION_API_KEY=

# Proposed limits; verify on the target PC.
MAX_UPLOAD_BYTES=31457280
MAX_PDF_PAGES=150
MAX_CONCURRENT_INGESTIONS=1

# Local deployment is NOT fully offline. Explicit opt-in before API calls.
LOCAL_ONLY=false
ALLOW_EXTERNAL_API=false
ALLOW_TELEMETRY=false
