# Local M1 configuration template. MCP 서버는 이 파일을 읽고 프로세스 환경을 우선한다.
APP_ENV=development
LOG_LEVEL=INFO
MCP_TRANSPORT=stdio

# Resolve this path to an absolute directory at startup.
DATA_ROOT=./runtime
# 다른 설정 파일을 사용하려면 프로세스 환경 변수 SOLO_LEVELING_ENV_FILE로 지정한다.
# These subdirectories are relative to DATA_ROOT.
IMPORT_SUBDIR=imports
PDF_SUBDIR=pdfs
SQLITE_FILENAME=solo_leveling.sqlite3
CHROMA_SUBDIR=chroma
MODEL_CACHE_SUBDIR=models
LOG_SUBDIR=logs

# Library selected; exact multilingual model/revision still to be selected.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=
EMBEDDING_REVISION=

# 답변 생성 설정. scripts/check_generation.py는 .env를 읽고 기존 환경 변수를 우선한다.
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_OUTPUT_TOKENS=2048

# 번역 모델·프롬프트는 답변 생성 설정과 별도로 관리한다. 키는 OPENAI_API_KEY를 공유한다.
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-5.4-mini
TRANSLATION_PROMPT_VERSION=ko-translation-v1
TRANSLATION_TARGET_LANGUAGE=ko
TRANSLATION_TIMEOUT_SECONDS=30
TRANSLATION_MAX_OUTPUT_TOKENS=4096

# Proposed limits; verify on the target PC.
MAX_UPLOAD_BYTES=31457280
MAX_PDF_PAGES=150
MAX_CONCURRENT_INGESTIONS=1

# Local deployment is NOT fully offline. Explicit opt-in before API calls.
LOCAL_ONLY=false
ALLOW_EXTERNAL_API=false
ALLOW_TELEMETRY=false
