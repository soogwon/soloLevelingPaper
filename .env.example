# Application
APP_ENV=development
LOG_LEVEL=INFO

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Local storage
PROFILE_DB_PATH=./runtime/profiles.sqlite3
GRAPH_STORE_PATH=./runtime/graph

# Model providers - finalize during Mini Project evaluation
LLM_PROVIDER=local
LLM_MODEL=your-local-model
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=your-local-embedding-model

# Safety and privacy
LOCAL_ONLY=true
ALLOW_EXTERNAL_API=false
ALLOW_TELEMETRY=false

