{
  "schema_version": 1,
  "concepts": [
    {
      "id": "dot-product",
      "name_ko": "내적",
      "name_en": "Dot product",
      "aliases": [
        "inner product",
        "점곱"
      ],
      "description_ko": "두 벡터의 같은 위치 원소를 곱해 모두 더한 값이다. 두 벡터가 얼마나 같은 방향을 향하는지, 즉 유사도를 재는 데 쓴다."
    },
    {
      "id": "matrix-multiplication",
      "name_ko": "행렬 곱",
      "name_en": "Matrix multiplication",
      "aliases": [
        "matmul",
        "행렬 곱셈"
      ],
      "description_ko": "한 행렬의 행과 다른 행렬의 열 사이의 내적을 모두 모아 새 행렬을 만드는 연산이다. 여러 벡터 쌍의 내적을 한 번에 계산할 수 있다."
    },
    {
      "id": "softmax",
      "name_ko": "소프트맥스",
      "name_en": "Softmax",
      "aliases": [
        "소프트맥스 함수"
      ],
      "description_ko": "점수 벡터를 0과 1 사이의 값으로 바꾸고 합이 1이 되게 만드는 함수다. 점수를 확률 분포나 가중치로 해석할 때 쓴다."
    },
    {
      "id": "word-embedding",
      "name_ko": "단어 임베딩",
      "name_en": "Word embedding",
      "aliases": [
        "token embedding",
        "임베딩",
        "embedding"
      ],
      "description_ko": "단어(토큰)를 학습 가능한 실수 벡터로 바꾼 표현이다. 의미가 비슷한 단어일수록 가까운 벡터가 되도록 학습된다."
    },
    {
      "id": "recurrent-neural-network",
      "name_ko": "순환 신경망",
      "name_en": "Recurrent neural network",
      "aliases": [
        "rnn",
        "lstm",
        "gru"
      ],
      "description_ko": "시퀀스를 한 위치씩 차례로 읽으며 이전 상태를 다음 계산에 넘기는 신경망이다. 순서대로 계산해야 하므로 병렬화가 어렵고 먼 위치 사이의 정보 전달이 약하다."
    },
    {
      "id": "encoder-decoder",
      "name_ko": "인코더-디코더 구조",
      "name_en": "Encoder-decoder architecture",
      "aliases": [
        "sequence-to-sequence",
        "seq2seq"
      ],
      "description_ko": "입력 시퀀스를 인코더가 내부 표현으로 바꾸고, 디코더가 그 표현을 보며 출력 시퀀스를 한 토큰씩 생성하는 구조다. 기계 번역의 기본 틀이다."
    },
    {
      "id": "attention-mechanism",
      "name_ko": "어텐션 메커니즘",
      "name_en": "Attention mechanism",
      "aliases": [
        "attention",
        "어텐션"
      ],
      "description_ko": "출력을 만들 때 입력의 모든 위치를 살펴보고, 관련도에 따라 가중치를 주어 정보를 모으는 방법이다. 관련도 점수를 소프트맥스로 가중치로 바꾼다."
    },
    {
      "id": "scaled-dot-product-attention",
      "name_ko": "스케일드 닷-프로덕트 어텐션",
      "name_en": "Scaled dot-product attention",
      "aliases": [
        "scaled attention",
        "query key value",
        "qkv"
      ],
      "description_ko": "쿼리와 키의 내적을 키 차원의 제곱근으로 나눈 뒤 소프트맥스를 적용하고, 그 가중치로 값(value)을 더하는 어텐션이다. 차원이 클 때 내적 값이 커져 소프트맥스가 한쪽으로 쏠리는 것을 막는다."
    },
    {
      "id": "self-attention",
      "name_ko": "셀프 어텐션",
      "name_en": "Self-attention",
      "aliases": [
        "intra-attention",
        "자기 어텐션"
      ],
      "description_ko": "한 시퀀스 안의 각 위치가 같은 시퀀스의 모든 위치를 참고해 자신의 표현을 갱신하는 어텐션이다. 쿼리, 키, 값이 모두 같은 시퀀스에서 나온다."
    },
    {
      "id": "multi-head-attention",
      "name_ko": "멀티헤드 어텐션",
      "name_en": "Multi-head attention",
      "aliases": [
        "multi-head",
        "멀티 헤드 어텐션"
      ],
      "description_ko": "쿼리, 키, 값을 서로 다른 여러 부분 공간으로 투영해 어텐션을 병렬로 여러 번 수행하고 결과를 이어 붙이는 방식이다. 서로 다른 종류의 관계를 동시에 포착할 수 있다."
    },
    {
      "id": "masked-self-attention",
      "name_ko": "마스크드 셀프 어텐션",
      "name_en": "Masked self-attention",
      "aliases": [
        "causal attention",
        "decoder masking",
        "마스킹"
      ],
      "description_ko": "디코더에서 각 위치가 자신보다 뒤의 위치를 보지 못하도록 해당 점수를 가리는 셀프 어텐션이다. 학습 중에도 생성 시점과 같은 조건을 유지한다."
    },
    {
      "id": "positional-encoding",
      "name_ko": "위치 인코딩",
      "name_en": "Positional encoding",
      "aliases": [
        "position embedding",
        "위치 임베딩",
        "position embeddings"
      ],
      "description_ko": "토큰의 위치 정보를 벡터로 만들어 임베딩에 더하는 방법이다. 셀프 어텐션 자체는 순서를 구분하지 못하므로 순서 정보를 따로 넣어 준다."
    },
    {
      "id": "position-wise-feed-forward",
      "name_ko": "위치별 피드포워드 네트워크",
      "name_en": "Position-wise feed-forward network",
      "aliases": [
        "ffn",
        "feed-forward network",
        "피드포워드"
      ],
      "description_ko": "각 위치의 벡터에 같은 2층 완전연결 신경망을 독립적으로 적용하는 층이다. 어텐션으로 모은 정보를 위치마다 비선형 변환한다."
    },
    {
      "id": "residual-connection",
      "name_ko": "잔차 연결",
      "name_en": "Residual connection",
      "aliases": [
        "skip connection",
        "residual",
        "스킵 연결"
      ],
      "description_ko": "층의 입력을 출력에 그대로 더해 주는 연결이다. 깊은 신경망에서도 기울기가 잘 전달되어 학습이 안정된다."
    },
    {
      "id": "layer-normalization",
      "name_ko": "층 정규화",
      "name_en": "Layer normalization",
      "aliases": [
        "layernorm",
        "layer norm",
        "레이어 정규화"
      ],
      "description_ko": "한 샘플의 한 위치 벡터 안에서 평균과 분산으로 값을 정규화하는 방법이다. 배치 크기와 관계없이 학습을 안정시킨다."
    },
    {
      "id": "transformer-encoder",
      "name_ko": "트랜스포머 인코더",
      "name_en": "Transformer encoder",
      "aliases": [
        "encoder stack",
        "인코더 블록"
      ],
      "description_ko": "멀티헤드 셀프 어텐션과 위치별 피드포워드 층을 잔차 연결과 층 정규화로 감싸 여러 겹 쌓은 블록이다. BERT와 ViT는 이 인코더만 사용한다."
    },
    {
      "id": "transformer",
      "name_ko": "트랜스포머",
      "name_en": "Transformer",
      "aliases": [
        "transformer architecture",
        "트랜스포머 구조"
      ],
      "description_ko": "순환이나 합성곱 없이 어텐션만으로 인코더와 디코더를 쌓은 시퀀스 변환 모델이다. 모든 위치를 병렬로 계산할 수 있어 학습이 빠르다."
    },
    {
      "id": "dropout",
      "name_ko": "드롭아웃",
      "name_en": "Dropout",
      "aliases": [
        "residual dropout"
      ],
      "description_ko": "학습 중 일부 뉴런 출력을 무작위로 0으로 만들어 특정 경로에 과하게 의존하지 않게 하는 정규화 기법이다."
    },
    {
      "id": "label-smoothing",
      "name_ko": "레이블 스무딩",
      "name_en": "Label smoothing",
      "aliases": [
        "라벨 스무딩"
      ],
      "description_ko": "정답 레이블의 확률을 1보다 조금 낮추고 나머지를 다른 클래스에 나눠 주는 학습 기법이다. 모델이 과도하게 확신하지 않게 만든다."
    },
    {
      "id": "learning-rate-warmup",
      "name_ko": "학습률 워밍업",
      "name_en": "Learning rate warmup",
      "aliases": [
        "warmup",
        "warmup steps",
        "워밍업"
      ],
      "description_ko": "학습 초반 일정 단계 동안 학습률을 0에서 점차 키운 뒤 줄여 나가는 스케줄이다. 초기의 불안정한 큰 업데이트를 막는다."
    },
    {
      "id": "language-model",
      "name_ko": "언어 모델",
      "name_en": "Language model",
      "aliases": [
        "language modeling",
        "언어 모델링"
      ],
      "description_ko": "앞뒤 문맥이 주어졌을 때 단어가 나올 확률을 예측하도록 학습한 모델이다. 대량의 텍스트만으로 학습할 수 있어 사전학습 과제로 널리 쓰인다."
    },
    {
      "id": "transfer-learning",
      "name_ko": "전이 학습",
      "name_en": "Transfer learning",
      "aliases": [
        "전이학습"
      ],
      "description_ko": "한 과제에서 학습한 모델의 지식을 다른 과제에 옮겨 쓰는 방법이다. 라벨이 적은 과제에서도 좋은 성능을 내게 해 준다."
    },
    {
      "id": "pretraining-fine-tuning",
      "name_ko": "사전학습과 미세조정",
      "name_en": "Pre-training and fine-tuning",
      "aliases": [
        "pre-training",
        "fine-tuning",
        "사전 학습",
        "파인튜닝"
      ],
      "description_ko": "대량의 데이터로 범용 모델을 먼저 학습한 뒤, 목표 과제의 적은 데이터로 전체 모델을 조금 더 학습하는 2단계 방식이다."
    },
    {
      "id": "subword-tokenization",
      "name_ko": "서브워드 토큰화",
      "name_en": "Subword tokenization",
      "aliases": [
        "wordpiece",
